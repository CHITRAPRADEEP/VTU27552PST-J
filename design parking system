class ParkingSystem {
public:
    int parking[3];

    ParkingSystem(int big, int medium, int small) {
        parking[0] = big;
        parking[1] = medium;
        parking[2] = small;
    }

    bool addCar(int carType) {
        if (parking[carType - 1] > 0) {
            parking[carType - 1]--;
            return true;
        }

        return false;
    }
};
