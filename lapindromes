import java.util.Scanner;

class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNextInt()) return;
        
        int t = sc.nextInt();
        while (t-- > 0) {
            String s = sc.next();
            if (isLapindrome(s)) {
                System.out.println("YES");
            } else {
                System.out.println("NO");
            }
        }
        sc.close();
    }

    private static boolean isLapindrome(String s) {
        int n = s.length();
        int mid = n / 2;
        int[] count1 = new int[26];
        int[] count2 = new int[26];

        // Populate frequency for the first half
        for (int i = 0; i < mid; i++) {
            count1[s.charAt(i) - 'a']++;
        }

        // Populate frequency for the second half 
        for (int i = n - mid; i < n; i++) {
            count2[s.charAt(i) - 'a']++;
        }

        // Compare the two frequency arrays
        for (int i = 0; i < 26; i++) {
            if (count1[i] != count2[i]) {
                return false;
            }
        }

        return true;
    }
}


