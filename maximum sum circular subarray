class Solution {
    public int maxSubarraySumCircular(int[] nums) {
        int totalSum = 0;
        int currMax = 0;
        int maxSum = nums[0];
        
        int currMin = 0;
        int minSum = nums[0];
        
        for (int num : nums) {
            // Standard Kadane's to find Maximum Subarray Sum
            currMax = Math.max(currMax + num, num);
            maxSum = Math.max(maxSum, currMax);
            
            // Kadane's variation to find Minimum Subarray Sum
            currMin = Math.min(currMin + num, num);
            minSum = Math.min(minSum, currMin);
            
            totalSum += num;
        }
        
        // If all numbers are negative, maxSum will be the highest negative element
        if (maxSum < 0) {
            return maxSum;
        }
        
        return Math.max(maxSum, totalSum - minSum);
    }
}
